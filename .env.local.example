# ── Multi-tenant note ───────────────────────────────────────────────────
# This app serves multiple client dashboards from one deployment
# (analytics.pixolab.com.mx/{client}/...). Env vars below are split into
# GLOBAL (shared across every client — one integration account/instance)
# and PER-CLIENT (prefixed CLIENT_<SLUG>_*, resolved at runtime by
# lib/client-config.ts based on the `client` URL segment). Adding a new
# client needs BOTH: a row in the `clients` table (slug/display_name/
# favicon_path — see db/migrations/004_multi_tenant.sql) AND its own
# CLIENT_<SLUG>_* block below. The example values throughout are for the
# `lumiservicios` slug, today's only real client — copy the pattern for a
# second one rather than guessing the shape.

# Self-hosted OpenPanel API base (no trailing slash, includes /api) — one
# instance serves every client.
OPENPANEL_API_URL=https://analytics.pixolab.com.mx/api

# Google Search Console service account — one Google Cloud project/service
# account is shared across every client; only the site URL is per-client.
# Setup: Google Cloud Console → enable "Search Console API" → create a
# service account → generate a JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key exactly as-is, including the
# literal \n sequences — lib/gsc.ts converts them to real newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Ads OAuth — one Pixolab-owned MCC/OAuth app is shared across every
# client; only the target customer id is per-client. Setup:
# 1. Get a Developer Token from a Google Ads Manager (MCC) account →
#    Tools & Settings → API Center. It starts at "Test account access" —
#    that's enough to query real accounts in practice (verified live), no
#    need to wait for Basic access approval.
# 2. Google Cloud Console (same project as GSC) → enable "Google Ads API" →
#    Credentials → Create OAuth client ID → type "Desktop app".
# 3. Run `node --env-file=.env.local scripts/get-google-ads-refresh-token.mjs`
#    (needs CLIENT_ID/SECRET already in this file) — it walks you through a
#    one-time browser authorization and prints the refresh token.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Leads database — shared Postgres for the whole Pixolab Dashboards
# ecosystem (not per-client), provisioned on Railway (project "Pixolab
# Dashboards", see pixolab-dashboards/_infra/README.md) — reuse this same
# instance for any future client dashboard's tables instead of
# provisioning a new one. Also backs `clients`/`users`/`client_memberships`/
# `auth_tokens`/`sessions` — one Postgres, one connection, every table
# namespaced by its own migration file in db/migrations/.
DATABASE_URL=postgres://pixolab_dashboards_app:PASSWORD@HOST:5432/pixolab_dashboards
# Shared secret every client's GTM tag sends as `x-ingest-secret` — not
# real security (ships in client-side JS, anyone can read it in devtools),
# just spam/noise reduction, so one shared value across all clients is
# fine. Generate a long random string.
LEADS_INGEST_SECRET=

# Auth — invite-gated email+password login, see
# db/migrations/{003_auth,004_multi_tenant}.sql and lib/auth/*. Access is
# managed from the "Compartir" button in each client dashboard's Topbar
# (Drive-style: invite by email, revoke access) — there's no separate
# admin panel. @pixolab.com.mx staff get automatic access to every client;
# anyone else needs an explicit per-client invite and a password.
#
# RESEND_API_KEY: resend.com → API Keys. Needs a verified sending domain
# (pixolab.com.mx) under Domains.
RESEND_API_KEY=
EMAIL_FROM="Pixolab Dashboards <dashboard@pixolab.com.mx>"
# Base URL used to build invite/reset links in emails — no trailing slash.
# http://localhost:3000 in dev; https://analytics.pixolab.com.mx once
# deployed.
APP_URL=http://localhost:3000

# ── Per-client config: lumiservicios ────────────────────────────────────
# Needs a matching row in `clients` (slug='lumiservicios') — see
# db/migrations/004_multi_tenant.sql for the one already inserted.

# Create this in the OpenPanel dashboard: Lumiservicios project → Settings →
# Clients → Create a client → type "Read". The default write client (used
# for the GTM tracking snippet) cannot access this API.
CLIENT_LUMISERVICIOS_OPENPANEL_CLIENT_ID=
CLIENT_LUMISERVICIOS_OPENPANEL_CLIENT_SECRET=
# The OpenPanel project id (not the client id) — "lumiservicios"
CLIENT_LUMISERVICIOS_OPENPANEL_PROJECT_ID=lumiservicios

# Must match the property's exact format in Search Console — a domain
# property looks like "sc-domain:example.com", a URL-prefix property looks
# like "https://example.com/". Not interchangeable. Also add the shared
# GOOGLE_SERVICE_ACCOUNT_EMAIL above as a Restricted user on this property.
CLIENT_LUMISERVICIOS_GSC_SITE_URL=sc-domain:lumiservicios.com

# The target Google Ads account id (digits only, no dashes) — if you don't
# know it, `client.listAccessibleCustomers()` (see google-ads-api's README)
# lists every account the shared refresh token above can reach.
CLIENT_LUMISERVICIOS_GOOGLE_ADS_CUSTOMER_ID=
